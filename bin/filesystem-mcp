#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
TS_ENTRY="$ROOT/dist/index.js"

resolve_rust_bin() {
	if [[ -n "${FILESYSTEM_MCP_RUST_BIN:-}" && -x "${FILESYSTEM_MCP_RUST_BIN}" ]]; then
		printf '%s\n' "${FILESYSTEM_MCP_RUST_BIN}"
		return 0
	fi

	for candidate in \
		"$ROOT/bin/native/filesystem-mcp-server" \
		"$ROOT/target/release/filesystem-mcp-server" \
		"$ROOT/target/debug/filesystem-mcp-server"; do
		if [[ -x "$candidate" ]]; then
			printf '%s\n' "$candidate"
			return 0
		fi
	done

	return 1
}

use_rust_transport() {
	[[ "${FILESYSTEM_MCP_TRANSPORT:-}" == "rust" ]] || [[ "${1:-}" == "rust" ]]
}

if use_rust_transport "$@"; then
	if [[ "${1:-}" == "rust" ]]; then
		shift
	fi
	if bin="$(resolve_rust_bin)"; then
		exec "$bin" "$@"
	fi
	echo "[filesystem-mcp] Rust MCP transport requested but filesystem-mcp-server is not built. Run: bun run build:rust" >&2
	exit 1
fi

exec node "$TS_ENTRY" "$@"