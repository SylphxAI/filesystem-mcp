#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export FILESYSTEM_ENGINE_SCRIPT="${FILESYSTEM_ENGINE_SCRIPT:-$ROOT/dist/engine-invoke.js}"

resolve_rust_bin() {
	if [[ -n "${FILESYSTEM_MCP_RUST_BIN:-}" && -x "${FILESYSTEM_MCP_RUST_BIN}" ]]; then
		printf '%s\n' "${FILESYSTEM_MCP_RUST_BIN}"
		return 0
	fi

	for candidate in \
		"$ROOT/target/release/filesystem-mcp-server" \
		"$ROOT/target/debug/filesystem-mcp-server"; do
		if [[ -x "$candidate" ]]; then
			printf '%s\n' "$candidate"
			return 0
		fi
	done

	return 1
}

if [[ "${1:-}" == "legacy" ]]; then
	shift
	exec node "$ROOT/dist/index.js" "$@"
fi

if bin="$(resolve_rust_bin)"; then
	exec "$bin" "$@"
fi

echo "[filesystem-mcp] Rust MCP binary missing; falling back to legacy TypeScript MCP transport." >&2
exec node "$ROOT/dist/index.js" "$@"